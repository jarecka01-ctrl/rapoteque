# Public site URL (used for canonical URLs, sitemap and Printful print-file URLs)
NEXT_PUBLIC_SITE_URL=https://rapoteque.com

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Printful (https://www.printful.com/dashboard/developer -> private token)
PRINTFUL_API_KEY=...
# Optional: Printful store id if the token has access to several stores
PRINTFUL_STORE_ID=
# "true" sends orders straight to production; anything else creates drafts you confirm by hand
PRINTFUL_AUTO_CONFIRM=false
